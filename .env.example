# Browser build-time configuration. Only VITE_* values are bundled into the client.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=

# Local scripts and GitHub Actions only. Never expose SUPABASE_KEY in a Vite build.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=
HARVARD_API_KEY=
# Optional sync safety controls. Keep deletion disabled until production source
# coverage and the live_courses.synced_at trigger are independently verified.
SYNC_MIN_UNIQUE_COURSES=1
SYNC_ALLOW_STALE_DELETE=false

# Cloudflare Pages Functions bindings/secrets. Configure these in the Pages
# dashboard or through managed infrastructure; do not commit their values.
# JWT_SECRET=
# BREVO_API_KEY=
# OPENROUTER_API_KEY=
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=<at least 32 random characters; distinct from ADMIN_PASSWORD>
# SUPABASE_SERVICE_ROLE_KEY=<server-only secret/service-role key; never VITE_*>
# HKS_KV=<Cloudflare KV binding, not a string environment variable>
