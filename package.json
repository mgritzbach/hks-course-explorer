{
  "name": "hks-course-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "vite",
    "build:data": "python scripts/build_data.py",
    "prebuild": "npm run build:data",
    "build": "vite build",
    "check:vendor-integrity": "node scripts/verify_vendor_integrity.mjs",
    "check:architecture": "node scripts/check_architecture.mjs",
    "check:ui-complexity": "node scripts/check_ui_complexity.mjs",
    "check:runtime-contracts": "node scripts/check_runtime_contracts.mjs",
    "check:pages-headers": "node scripts/validate_pages_headers.mjs && vitest run --environment node scripts/validate_pages_headers.test.js",
    "check:contracts": "tsc --project tsconfig.contracts.json --noEmit",
    "check:format": "prettier --check \"{src,scripts,functions,tests}/**/*.{js,jsx,mjs,json}\" \"*.{js,json}\"",
    "format": "prettier --write \"{src,scripts,functions,tests}/**/*.{js,jsx,mjs,json}\" \"*.{js,json}\"",
    "check:bundle-budget": "node scripts/check_bundle_budget.mjs",
    "preview": "vite preview",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:build": "node scripts/run_e2e_build.mjs",
    "test:e2e:ci": "playwright test",
    "test:e2e:production": "playwright test --config=playwright.production.config.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@sentry/react": "^10.51.0",
    "@supabase/supabase-js": "^2.104.0",
    "ics": "^3.11.0",
    "plotly.js-dist-min": "^2.29.0",
    "posthog-js": "^1.407.2",
    "react": "^18.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.2.0",
    "react-plotly.js": "^2.6.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.8.1",
    "sharp": "^0.35.3",
    "uuid": "^14.0.0",
    "web-vitals": "^5.3.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@capacitor/cli": "^8.3.1",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^4.1.5",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "postcss": "^8.4.35",
    "prettier": "3.9.5",
    "tailwindcss": "^3.4.1",
    "typescript": "7.0.2",
    "vite": "^5.1.4",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "dompurify": "3.4.12"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "eslint --fix"
    ]
  }
}
