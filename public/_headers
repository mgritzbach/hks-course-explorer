/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=(), usb=()
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000

# Cloudflare Pages already revalidates static assets and clears its deployment
# cache when a new release is published. Do not override that policy here: an
# SPA fallback can temporarily answer a not-yet-propagated asset path with
# index.html, and an immutable rule would cache that wrong response for a year.
