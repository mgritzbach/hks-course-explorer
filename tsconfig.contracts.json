{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false
  },
  "include": [
    "src/lib/courseMeta.js",
    "src/lib/scheduleCourseNormalization.js",
    "src/lib/courseBrowserState.js",
    "src/lib/visitorNavigation.js",
    "src/lib/scatterData.js",
    "src/school.config.js"
  ]
}
